// Every encoder option ves knows, with a few values for each. A reference, not a run: all encoders are disabled, and the combinations multiply (x264's list
// alone is about 10^11 runs, x265's 10^14), so enable an encoder only after cutting its options down to the ones you want to compare.
//
// Notes:
//  - An option with a list of values is swept; null leaves it at the encoder's default; [] ignores it.
//  - Every combination is encoded. Runs that end up with exactly the same stream (options that changed nothing) are merged in the ranking afterwards.
//  - Names are snake_case. max_b_frames, lookahead_frames, max_ref_frames, b_reference_mode and rate_control are common: the same name and
//    meaning on every encoder that supports them. The rest are each library's own, converted (aq-mode is aq_mode, NVENC's enableLTR is enable_ltr).
//  - x264, x265 and SVT-AV1 take their command line names, so any option their CLI knows works, not only the ones listed here.
//    NVENC takes the quality-relevant scalar fields of its rate control, config and per-codec structures by their SDK names (no slicing, intra refresh,
//    temporal layers, stereo or colour signalling). QuickSync's are the fields of oneVPL's mfxInfoMFX and mfxExtCodingOption2/3. AMF's are AMF's own property
//    names for the codec; the list leaves out the read-only, per-frame and feedback properties.
//  - Run-tested with a short clip: every value of NVENC (H.264, HEVC, AV1), x264, x265 and SVT-AV1. AMF and QuickSync need hardware this was not
//    tested on: their names come from the SDK headers, and an unknown name fails the run with a message.
//  - Every encoder also takes "chroma" (420, 444), "bitdepth" (8, 10), "range" (source, limited, full) and, for GPU encoders, "gpu" (index, or "all").
{
	"output": "output",
	"scenarios": [
		{ "name": "sample", "bitrates": [4000], "resolutions": ["1920x1080"], "framerates": [30] },
	],
	"kfintervals": [2.0],
	"vmaf": { "model": "path=models/vmaf_v0.6.1.json", "over_penalty": 0.025 },
	"settings": { "cache": "cache" },

	"encoders": [
		// NVIDIA, H.264. The first block of options is shared by all three codecs; the names are NVENC's own fields (nvEncodeAPI.h), numeric
		{
			"enabled": false,
			"encoder": "nvenc",
			"codec": "h264",
			"options": {
				"preset": ["p1", "p2", "p3", "p4", "p5", "p6", "p7"],   // p1 fastest ... p7 slowest
				"tune": ["hq", "ll", "ull"],   // hq | ll | ull | lossless
				"profile": [null, "baseline", "main", "high", "constrained_high"],   // same names on every encoder; these suit 8-bit 4:2:0, the others (high10, high422, high444, main10, rext) need a matching bitdepth or chroma
				"level": [null, "auto", "3.1", "4.1", "5.1"],   // as the standards write it; null and auto leave it to the encoder
				"rate_control": ["cbr", "vbr"],   // rate control
				"max_b_frames": [null, 0, 1, 2, 3, 4],   // B-frames
				"lookahead_frames": [0, 8, 16, 32],   // frames of lookahead
				"spatial_aq": [null, 0, 1],
				"temporal_aq": [null, 0, 1],
				"aq_strength": [null, 1, 8, 15],   // 1..15
				"vbv_buffer_size": [0, 500000, 2000000],   // bits; 0 is the encoder's default
				"vbv_initial_delay": [0, 250000],   // bits
				"min_qp": [null, 10, 20],   // also switches the minimum QP on
				"max_qp": [null, 40, 51],   // also switches the maximum QP on
				"initial_rc_qp": [null, 26],   // also switches the initial QP on
				// "zero_reorder_delay": [null, 0, 1],   // only without B-frames: use it with "max_b_frames": [0]
				"enable_non_ref_p": [null, 0, 1],
				"strict_gop_target": [null, 0, 1],
				"disable_iadapt": [null, 0, 1],   // adaptive I-frames at scene cuts (lookahead only)
				"disable_badapt": [null, 0, 1],   // adaptive B-frame decision (lookahead only)
				"target_quality": [null, 20, 30],   // constant quality level for VBR
				"low_delay_key_frame_scale": [null, 1, 2, 4],   // ratio of I-frame to P-frame bits
				"multi_pass": [0, 1, 2],   // 0 off, 1 two passes (quarter resolution first), 2 two passes (full resolution first)
				// "lookahead_level": [0, 1, 2, 3],   // needs lookahead on: use it with "lookahead_frames" values above 0
				"mv_precision": [0, 1, 2, 3],   // 0 default, 1 full pel, 2 half pel, 3 quarter pel
				// "enable_weighted_prediction": [null, 0, 1],   // only without B-frames: use it with "max_b_frames": [0]
				"max_ref_frames_l0": [null, 1, 2, 4],   // 0 = automatic, up to 7
				"enable_filler_data_insertion": [null, 0, 1],   // pads CBR streams up to the bitrate
				"b_reference_mode": ["none", "middle", "each"],   // B-frames as references
				"entropy_coding_mode": [null, 1, 2],   // 1 CABAC, 2 CAVLC
				"adaptive_transform_mode": [null, 1, 2],   // 8x8 transform: 1 off, 2 on
				"bdirect_mode": [null, 1, 2, 3],   // 1 off, 2 temporal, 3 spatial
				"disable_deblocking_filter_idc": [null, 0, 1],   // 1 disables the filter
				"hierarchical_b_frames": [null, 0, 1],
				"max_ref_frames": [null, 3, 4],   // most reference frames
				// "num_ltr_frames": [null, 0, 1, 2, 4],   // long-term references exclude B-frames: use them with "max_b_frames": [0]
				"max_ref_frames_l1": [null, 1, 2],   // 0 = automatic, up to 7
			},
		},
		// NVIDIA, HEVC (the shared options as for H.264, then the HEVC ones)
		{
			"enabled": false,
			"encoder": "nvenc",
			"codec": "hevc",
			"options": {
				"preset": ["p1", "p2", "p3", "p4", "p5", "p6", "p7"],   // p1 fastest ... p7 slowest
				"tune": ["hq", "ll", "ull"],   // hq | ll | ull | lossless
				"profile": [null, "main"],   // same names on every encoder; these suit 8-bit 4:2:0, the others (high10, high422, high444, main10, rext) need a matching bitdepth or chroma
				"level": [null, "auto", "3.1", "4.1", "5.1"],   // as the standards write it; null and auto leave it to the encoder
				"rate_control": ["cbr", "vbr"],   // rate control
				"max_b_frames": [null, 0, 1, 2, 3, 4],   // B-frames
				"lookahead_frames": [0, 8, 16, 32],   // frames of lookahead
				"spatial_aq": [null, 0, 1],
				"temporal_aq": [null, 0, 1],
				"aq_strength": [null, 1, 8, 15],   // 1..15
				"vbv_buffer_size": [0, 500000, 2000000],   // bits; 0 is the encoder's default
				"vbv_initial_delay": [0, 250000],   // bits
				"min_qp": [null, 10, 20],   // also switches the minimum QP on
				"max_qp": [null, 40, 51],   // also switches the maximum QP on
				"initial_rc_qp": [null, 26],   // also switches the initial QP on
				// "zero_reorder_delay": [null, 0, 1],   // only without B-frames: use it with "max_b_frames": [0]
				"enable_non_ref_p": [null, 0, 1],
				"strict_gop_target": [null, 0, 1],
				"disable_iadapt": [null, 0, 1],   // adaptive I-frames at scene cuts (lookahead only)
				"disable_badapt": [null, 0, 1],   // adaptive B-frame decision (lookahead only)
				"target_quality": [null, 20, 30],   // constant quality level for VBR
				"low_delay_key_frame_scale": [null, 1, 2, 4],   // ratio of I-frame to P-frame bits
				"multi_pass": [0, 1, 2],   // 0 off, 1 two passes (quarter resolution first), 2 two passes (full resolution first)
				// "lookahead_level": [0, 1, 2, 3],   // needs lookahead on: use it with "lookahead_frames" values above 0
				"mv_precision": [0, 1, 2, 3],   // 0 default, 1 full pel, 2 half pel, 3 quarter pel
				// "enable_weighted_prediction": [null, 0, 1],   // only without B-frames: use it with "max_b_frames": [0]
				"max_ref_frames_l0": [null, 1, 2, 4],   // 0 = automatic, up to 7
				"enable_filler_data_insertion": [null, 0, 1],   // pads CBR streams up to the bitrate
				"b_reference_mode": ["none", "middle", "each"],   // B-frames as references
				"min_cu_size": [null, 1, 2, 3],   // 1 = 8x8 ... 4 = 64x64
				"max_cu_size": [null, 3, 4],
				"tier": [null, "main", "high"],   // same names on every encoder
				"disable_deblocking_filter_idc": [null, 0, 1],
				"split_encode_mode": [null, 0, 1, 2, 3],   // encodes on two NVENC engines where the GPU has them
				// "num_ltr_frames": [null, 0, 1, 2, 4],   // long-term references exclude B-frames: use them with "max_b_frames": [0]
				"max_ref_frames_l1": [null, 1, 2],   // 0 = automatic, up to 7
				"max_ref_frames": [null, 3, 4],   // B-frames as references need at least 3
			},
		},
		// NVIDIA, AV1 (the shared options as for H.264, then the AV1 ones)
		{
			"enabled": false,
			"encoder": "nvenc",
			"codec": "av1",
			"options": {
				"preset": ["p1", "p2", "p3", "p4", "p5", "p6", "p7"],   // p1 fastest ... p7 slowest
				"tune": ["hq", "ll", "ull"],   // hq | ll | ull | lossless
				"profile": [null, "main"],   // same names on every encoder; these suit 8-bit 4:2:0, the others (high10, high422, high444, main10, rext) need a matching bitdepth or chroma
				"level": [null, "auto", "4.0", "5.1"],   // as the standards write it; null and auto leave it to the encoder
				"rate_control": ["cbr", "vbr"],   // rate control
				"max_b_frames": [null, 0, 1, 2, 3, 4],   // B-frames
				"lookahead_frames": [0, 8, 16, 32],   // frames of lookahead
				"spatial_aq": [null, 0, 1],
				"temporal_aq": [null, 0, 1],
				"aq_strength": [null, 1, 8, 15],   // 1..15
				"vbv_buffer_size": [0, 500000, 2000000],   // bits; 0 is the encoder's default
				"vbv_initial_delay": [0, 250000],   // bits
				"min_qp": [null, 10, 20],   // also switches the minimum QP on
				"max_qp": [null, 40, 51],   // also switches the maximum QP on
				"initial_rc_qp": [null, 26],   // also switches the initial QP on
				// "zero_reorder_delay": [null, 0, 1],   // only without B-frames: use it with "max_b_frames": [0]
				"enable_non_ref_p": [null, 0, 1],
				"strict_gop_target": [null, 0, 1],
				"disable_iadapt": [null, 0, 1],   // adaptive I-frames at scene cuts (lookahead only)
				"disable_badapt": [null, 0, 1],   // adaptive B-frame decision (lookahead only)
				"target_quality": [null, 20, 30],   // constant quality level for VBR
				"low_delay_key_frame_scale": [null, 1, 2, 4],   // ratio of I-frame to P-frame bits
				"multi_pass": [0, 1, 2],   // 0 off, 1 two passes (quarter resolution first), 2 two passes (full resolution first)
				// "lookahead_level": [0, 1, 2, 3],   // needs lookahead on: use it with "lookahead_frames" values above 0
				"mv_precision": [0, 1, 2, 3],   // 0 default, 1 full pel, 2 half pel, 3 quarter pel
				// "enable_weighted_prediction": [null, 0, 1],   // only without B-frames: use it with "max_b_frames": [0]
				"tf_level": [null, 0, 4],   // temporal filtering; needs the GPU's support
				"max_ref_frames_forward": [null, 1, 2, 4],
				"max_ref_frames_backward": [null, 1, 2],
				"min_part_size": [null, 2, 3],   // 1 = 4x4 ... 5 = 64x64
				"max_part_size": [null, 4, 5],
				"tier": [null, "main", "high"],   // same names on every encoder
				"num_tile_columns": [null, 1, 2],
				"num_tile_rows": [null, 1, 2],
				"enable_custom_tile_config": [null, 0, 1],
				"enable_film_grain_params": [null, 0, 1],
				"split_encode_mode": [null, 0, 1, 2, 3],
				"y_dc_qp_index_offset": [null, -4, 4],   // also uDcQPIndexOffset, vDcQPIndexOffset
				// "num_ltr_frames": [null, 0, 1, 2, 4],   // long-term references exclude B-frames: use them with "max_b_frames": [0]
				"max_ref_frames": [null, 3, 4],   // B-frames as references need at least 3
			},
		},
		// software
		{
			"enabled": false,
			"encoder": "x264",
			"options": {
				"preset": ["ultrafast", "superfast", "veryfast", "faster", "fast", "medium", "slow", "slower", "veryslow", "placebo"],
				"tune": [null, "film", "animation", "grain", "stillimage", "psnr", "ssim", "fastdecode", "zerolatency"],
				"profile": [null, "main", "high"],   // high10 and high444 follow from bitdepth and chroma
				"level": [null, "auto", "3.1", "4.1", "5.1"],   // as the standards write it; null and auto leave it to the encoder
				"max_b_frames": [0, 3, 8],
				"b_adapt": [0, 1, 2],
				"b_reference_mode": ["none", "middle"],
				"max_ref_frames": [1, 3, 8],   // reference frames
				"lookahead_frames": [10, 40, 60],
				"subme": [2, 6, 10],   // sub-pixel motion estimation quality
				"me": ["dia", "hex", "umh", "esa"],   // motion estimation method
				"merange": [16, 24],
				"trellis": [0, 1, 2],
				"aq_mode": [0, 1, 2, 3],
				"aq_strength": [0.8, 1.0, 1.3],
				"weightp": [0, 1, 2],
				"direct": ["spatial", "temporal", "auto"],
				"deblock": ["0:0", "-1:-1"],   // alpha:beta
				"cabac": [0, 1],
				"8x8dct": [0, 1],
				"mbtree": [0, 1],
				"psy_rd": ["1.0:0.0", "0.0:0.0"],   // psy-rd:psy-trellis
				"qcomp": [0.6, 0.8],
				"nr": [0, 100],   // noise reduction
				"fast_pskip": [0, 1],
				"scenecut": [0, 40],
				"open_gop": [0, 1],
			},
		},
		// software; the profile also follows from "bitdepth"
		{
			"enabled": false,
			"encoder": "x265",
			"options": {
				"preset": ["ultrafast", "superfast", "veryfast", "faster", "fast", "medium", "slow", "slower", "veryslow", "placebo"],
				"tune": [null, "psnr", "ssim", "grain", "fastdecode", "zerolatency", "animation"],
				"profile": [null, "main", "main10"],
				"level": [null, "auto", "3.1", "4.1", "5.1"],   // as the standards write it; null and auto leave it to the encoder
				"max_b_frames": [0, 4, 8],
				"b_adapt": [0, 1, 2],
				"lookahead_frames": [15, 25, 40],
				"max_ref_frames": [1, 3, 5],
				"rd": [1, 3, 4, 6],   // rate-distortion level
				"subme": [1, 3, 5, 7],
				"me": ["dia", "hex", "umh", "star", "sea", "full"],
				"merange": [57, 92],
				"aq_mode": [0, 1, 2, 3, 4],
				"aq_strength": [0.8, 1.0, 1.4],
				"sao": [0, 1],
				"strong_intra_smoothing": [0, 1],
				"weightp": [0, 1],
				"weightb": [0, 1],
				"ctu": [16, 32, 64],
				"max_merge": [1, 3, 5],
				"rect": [0, 1],
				"amp": [0, 1],
				"tskip": [0, 1],
				"early_skip": [0, 1],
				"psy_rd": [0.0, 2.0],
				"psy_rdoq": [0.0, 1.0],
				"cutree": [0, 1],
				"limit_refs": [0, 1, 3],
				"frame_threads": [1, 2, 4],
				"wpp": [0, 1],
				"open_gop": [0, 1],
				"scenecut": [0, 40],
				"deblock": ["0:0", "-1:-1"],   // tc:beta
				"b_reference_mode": ["none", "middle"],   // B-frames as references
				"tier": [null, "main", "auto"],   // x265 cannot force the high tier: main never uses it, auto uses it when the bitrate needs it
			},
		},
		// software. Runs as CBR with the low-delay prediction structure. Not deterministic: its results vary a little between runs
		{
			"enabled": false,
			"encoder": "svtav1",
			"options": {
				"preset": [0, 2, 4, 6, 8, 10, 12, 13],   // 0 slowest ... 13 fastest
				"tune": [0, 1],   // 0 visual quality, 1 PSNR (2, SSIM, needs CRF rate control)
				"profile": [null, "main"],   // high needs 4:4:4
				"level": [null, "auto", "4.0", "5.1"],   // as the standards write it; null and auto leave it to the encoder
				"lookahead_frames": [0, 16, 60],
				"enable_tf": [0, 1, 2],   // temporal filtering
				"film_grain": [0, 8, 25],
				"film_grain_denoise": [0, 1],
				"enable_cdef": [0, 1],
				"enable_restoration": [0, 1],
				"aq_mode": [1, 2],   // 0 (off) is rejected with rate control, so it is left out
				"scd": [0, 1],   // scene change detection
				"fast_decode": [0, 1, 2],
				"enable_qm": [0, 1],   // quantization matrices
				"tile_rows": [0, 1],
				"tile_columns": [0, 1],
				"enable_dlf": [0, 1, 2],   // deblocking filter
				"enable_variance_boost": [0, 1],
				"variance_boost_strength": [1, 2, 3, 4],
				"rate_control": ["cbr", "vbr"],   // cbr runs with the low-delay prediction structure, vbr with random access
			},
		},
		// AMD, H.264; property names as AMF spells them, values numeric
		{
			"enabled": false,
			"encoder": "amf",
			"codec": "h264",
			"options": {
				"preset": ["balanced", "speed", "quality", "high_quality"],   // speed ... high_quality
				"profile": ["baseline", "constrained_baseline", "main", "high", "constrained_high"],   // same names on every encoder
				"max_b_frames": [0, 1, 2, 3],   // B-frames between P-frames
				"level": [null, "auto", "3.1", "4.1", "5.1"],   // as the standards write it; null and auto leave it to the encoder
				"b_reference_mode": ["none", "middle"],
				"max_ref_frames": [1, 2, 4],
				"enable_vbaq": [0, 1],
				"high_motion_quality_boost_enable": [0, 1],
				"enforce_hrd": [0, 1],
				"filler_data_enable": [0, 1],
				"vbv_buffer_size": [null, 1000000, 4000000],   // bits
				"de_blocking_filter": [0, 1],
				"cabac_enable": [0, 1],
				"rate_control_skip_frame_enable": [0, 1],
				"low_latency_internal": [0, 1],
				"pre_encode": [0, 1],   // pre-encode assisted rate control
				"enable_pre_analysis": [0, 1],   // pre-analysis; the pa_* options (pa_scene_change_detection_enable, pa_look_ahead_buffer_depth, pa_perceptual_aq_mode, ...) exist once it is on, and it needs rate_control_method 2 (peak constrained VBR)
				"pre_filter": [0, 1],   // AMF's adaptive filter in front of the encoder
				"pre_filter_strength": [0, 4, 10],   // 0 to 10, with pre_filter
				"pre_filter_sensitivity": [0, 4, 10],   // 0 to 10, lower keeps more detail
			},
		},
		// AMD, HEVC
		{
			"enabled": false,
			"encoder": "amf",
			"codec": "hevc",
			"options": {
				"preset": ["quality", "balanced", "speed", "high_quality"],   // speed ... high_quality
				"profile": ["main", "main10"],   // same names on every encoder
				"tier": [null, "main", "high"],   // same names on every encoder
				"level": [null, "auto", "3.1", "4.1", "5.1"],   // as the standards write it; null and auto leave it to the encoder
				"max_ref_frames": [1, 2, 4],
				"enable_vbaq": [0, 1],
				"high_motion_quality_boost_enable": [0, 1],
				"enforce_hrd": [0, 1],
				"filler_data_enable": [0, 1],
				"vbv_buffer_size": [null, 1000000, 4000000],   // bits
				"de_blocking_filter": [0, 1],
				"rate_control_skip_frame_enable": [0, 1],
			},
		},
		// AMD, AV1
		{
			"enabled": false,
			"encoder": "amf",
			"codec": "av1",
			"options": {
				"preset": ["high_quality", "quality", "balanced", "speed"],   // speed ... high_quality
				"aq_mode": [0, 1],   // 0 none, 1 content adaptive
				"profile": [null, "main"],   // same names on every encoder; left unset the encoder picks one that fits the chroma layout and bit depth
				"level": [null, "auto", "4.0", "5.1"],   // as the standards write it; null and auto leave it to the encoder
				"high_motion_quality_boost": [0, 1],
				"num_tiles_per_frame": [1, 2, 4],
				"cdef_mode": [0, 1],
				"screen_content_tools": [0, 1],
				"palette_mode": [0, 1],
				"cdf_update": [0, 1],
				"enforce_hrd": [0, 1],
				"filler_data": [0, 1],
				"max_ref_frames": [1, 2, 4],
				"vbv_buffer_size": [null, 1000000, 4000000],   // bits
			},
		},
		// Intel; codec h264, hevc or av1
		{
			"enabled": false,
			"encoder": "qsv",
			"codec": "hevc",
			"options": {
				"preset": ["best_quality", "balanced", "best_speed"],   // QuickSync's target usage; 1..7 also work
				"max_b_frames": [0, 1, 3, 7],   // 1 = no B-frames
				"profile": [null, "main", "main10", "rext"],   // same names on every encoder; left unset the encoder picks one that fits the chroma layout and bit depth
				"level": [null, "auto", "3.1", "4.1", "5.1"],   // as the standards write it; null and auto leave it to the encoder
				"max_ref_frames": [1, 2, 4],
				"low_power": [null, 0, 1],   // 1 fixed-function encoder, 0 shader based
				"buffer_size_in_kb": [null, 500, 2000],
				"gop_opt_flag": [null, 1, 2],   // 1 closed GOP, 2 strict GOP
				"mbbrc": [null, "on", "off"],   // macroblock-level rate control
				"ext_brc": [null, "on", "off"],
				"lookahead_frames": [0, 20, 40],
				"trellis": [null, 0, 1],
				"b_reference_mode": ["none", "middle"],   // 0 unspecified, 1 off, 2 pyramid
				"adaptive_i": [null, "on", "off"],
				"adaptive_b": [null, "on", "off"],
				"look_ahead_ds": [null, 0, 1, 2],   // lookahead downscale
				"min_qpi": [null, 10],
				"max_qpi": [null, 45],
				"min_qpp": [null, 10],
				"max_qpp": [null, 45],
				"min_qpb": [null, 10],
				"max_qpb": [null, 45],
				"disable_deblocking_idc": [null, 0, 1],
				"weighted_pred": [null, 0, 1],
				"weighted_bi_pred": [null, 0, 1],
				"scenario_info": [null, 0, 1, 2, 3, 4],   // see mfxExtCodingOption3
				"content_info": [null, 0, 1, 2],
				"p_ref_type": [null, 0, 1, 2],
				"gpb": [null, "on", "off"],   // generalized P/B
