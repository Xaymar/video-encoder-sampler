#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 16, local_size_y = 16) in;
#include "adm_common.glsl"
// Splits the distorted bands into the part that follows the reference (restored) and the rest (additive impairment).

#include "adm_decouple.glsl"

void main() {
	const int j = int(gl_GlobalInvocationID.x), i = int(gl_GlobalInvocationID.y);
	if (j < pc.dl || j >= pc.dr || i < pc.dt || i >= pc.db) return;
	const int N = pc.BW * pc.BH, o = i * pc.BW + j;
	int x[3], a[3], kh, r0h;
	bool angle_flag;
	decouple(o, N, x, a, angle_flag, kh, r0h);
	cur[XH * N + o] = x[0]; cur[XV * N + o] = x[1]; cur[XD * N + o] = x[2];
	cur[AH * N + o] = a[0]; cur[AV * N + o] = a[1]; cur[AD * N + o] = a[2];
	if (pc.dbg != 0) { cur[AH * N + o] = kh; cur[AV * N + o] = angle_flag ? 1 : 0; cur[AD * N + o] = r0h; }
}
