#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 256) in;
#include "speed_common.glsl"
// One workgroup per chroma plane (q: reference plane q, decoded plane q + 2): get_speed_score() over the blocks, one after another as on the CPU,
// and what the scorer makes of a matrix that could not be inverted (one of the two: 0).

// Block i's term of the score: |spatial_ref - spatial_dis|, or 0 where both entropies are below the base one (as score += 0.0 adds nothing).
float block_term(int r0, int d0, int i) {
	const float re = blk[r0 + i], de = blk[d0 + i], rv = blk[r0 + pc.nb + i], dv = blk[d0 + pc.nb + i];
	if (re < pc.base_entropy && de < pc.base_entropy) return 0.0;
	precise float one_r = 1.0 + rv, one_d = 1.0 + dv;
	precise float rd = rv + dv;
	double lr, ld;
	if (pc.mode == 0) { lr = log2d(double(one_r)); ld = log2d(double(one_d)); }
	else if (pc.mode == 1) { lr = log2d(double(one_r)); ld = lr; }
	else if (pc.mode == 2) { lr = log2d(double(one_d)); ld = lr; }
	else if (pc.mode == 3) { precise double m = 1.0LF + double(rd) * 0.5LF; lr = log2d(m); ld = lr; }
	else if (pc.mode == 4) { precise double m = 1.0LF + double(rd) * 0.5LF; lr = log2d(double(one_r)); ld = log2d(m); }
	else if (pc.mode == 5) { precise double m = 1.0LF + (0.75LF * double(rv) + 0.25LF * double(dv)); lr = log2d(double(one_r)); ld = log2d(m); }
	else { precise double m = 1.0LF + (0.25LF * double(rv) + 0.75LF * double(dv)); lr = log2d(double(one_r)); ld = log2d(m); }
	precise double sr = double(re) * lr, sdd = double(de) * ld;
	const float spatial_ref = rf(sr), spatial_dis = rf(sdd);
	precise float diff = spatial_ref - spatial_dis;
	return abs(diff);
}

const int MAXB = 2048;
shared float gTerm[MAXB];

void main() {
	const int q = int(gl_WorkGroupID.y), r0 = q * 2 * pc.nb, d0 = (q + 2) * 2 * pc.nb;
	const uint t = gl_LocalInvocationID.x;
	// The blocks' terms in parallel (each one's own float and double steps), then their sum one after another, in order, as on the CPU.
	const bool par = pc.nb <= MAXB;
	if (par) for (int i = int(t); i < pc.nb; i += 256) gTerm[i] = block_term(r0, d0, i);
	barrier();
	if (t != 0u) return;
	const bool err_ref = cannot_invert(q * SMALL), err_dis = cannot_invert((q + 2) * SMALL);
	precise float score = 0.0;
	for (int i = 0; i < pc.nb; i++) score += par ? gTerm[i] : block_term(r0, d0, i);
	float res = fdiv(score, float(pc.nb));
	if (err_ref != err_dis) res = 0.0;
	fin[q * 2] = res;
	fin[q * 2 + 1] = (err_ref || err_dis) ? 1.0 : 0.0;
}
