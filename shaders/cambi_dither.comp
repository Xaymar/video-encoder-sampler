#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 16, local_size_y = 16) in;
#include "cambi_common.glsl"
// The anti-dithering filter for encodes below 10 bit: each sample becomes the mean of it and its right, lower and lower right neighbours (fewer at the edges).
layout(std430, binding = 0) readonly buffer In { uint src[]; };
layout(std430, binding = 1) writeonly buffer Out { uint dst[]; };

void main() {
	const int j = int(gl_GlobalInvocationID.x), i = int(gl_GlobalInvocationID.y);
	if (j >= pc.W || i >= pc.H) return;
	const int w = pc.W, h = pc.H;
	uint v;
	if (i < h - 1 && j < w - 1) v = (src[i * w + j] + src[i * w + j + 1] + src[(i + 1) * w + j] + src[(i + 1) * w + j + 1]) >> 2;
	else if (i < h - 1) v = (src[i * w + j] + src[(i + 1) * w + j]) >> 1;
	else if (j < w - 1) v = (src[i * w + j] + src[i * w + j + 1]) >> 1;
	else v = src[i * w + j];
	dst[i * w + j] = v;
}
