#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 16, local_size_y = 16) in;
#include "cambi_common.glsl"
// cambi_pre, cambi_mask and (with pc.pad > 0) scale 0's cambi_decimate in one pass, the same steps, for 10 bit and deeper encodes (no
// anti-dithering): a workgroup takes the frame at the encoded size for its 16x16 tile and a 3 (+1) pixel border into shared memory, works out the
// spatial mask there, and writes the image and the mask, at the encoded size or (pc.pad x pc.nd > 0) only every second sample of both (scale 0).
// pc.W, pc.H: the scored frame; pc.OW, pc.OH: the encoded size; pc.pad, pc.nd here: the decimated size (0: none).
layout(std430, binding = 0) readonly buffer Raw { uint raw[]; };
layout(std430, binding = 1) readonly buffer Idx { int idx[]; };   // OW column positions, then OH row positions
layout(std430, binding = 2) writeonly buffer OImg { uint oimg[]; };
layout(std430, binding = 3) writeonly buffer OMask { uint omask[]; };

const int T = 16, R = 3, E = T + 2 * R, F = E + 1; // tile; window radius; the zero derivatives' tile; the samples' (one more right and down)
shared uint gImg[F * F];
shared uint gZero[E * E];
shared uint gRows[E * T];

int sample_at(int i) {
	if (pc.bpc > 8) return int((raw[i >> 1] >> ((i & 1) * 16)) & 65535u);
	return int((raw[i >> 2] >> ((i & 3) * 8)) & 255u);
}
uint pre(int y, int x) { // cambi_pre's value at (x, y) of the encoded size
	const int v = sample_at(idx[pc.OW + y] * pc.W + idx[x]);
	int o;
	if (pc.bpc < 10) o = v << (10 - pc.bpc);
	else if (pc.bpc == 10) o = v;
	else { const int sh = pc.bpc - 10; o = (v + (1 << (sh - 1))) >> sh; }
	return uint(o);
}

void main() {
	const int t = int(gl_LocalInvocationIndex);
	const int W = pc.OW, H = pc.OH;
	const int c0 = int(gl_WorkGroupID.x) * T - R, r0 = int(gl_WorkGroupID.y) * T - R;
	for (int i = t; i < F * F; i += T * T) {
		const int r = r0 + i / F, c = c0 + i % F;
		gImg[i] = r >= 0 && c >= 0 && r < H && c < W ? pre(r, c) : 0u;
	}
	barrier();
	for (int i = t; i < E * E; i += T * T) { // cambi_mask's zero derivatives (the last column and row count as equal; outside as not)
		const int lr = i / E, lc = i % E, r = r0 + lr, c = c0 + lc;
		uint z = 0u;
		if (r >= 0 && c >= 0 && r < H && c < W) {
			const uint v = gImg[lr * F + lc];
			const bool hz = c == W - 1 || v == gImg[lr * F + lc + 1];
			const bool vt = r == H - 1 || v == gImg[(lr + 1) * F + lc];
			z = hz && vt ? 1u : 0u;
		}
		gZero[i] = z;
	}
	barrier();
	for (int i = t; i < E * T; i += T * T) {
		const int row = i / T, col = i % T;
		uint n = 0u;
		for (int d = 0; d <= 2 * R; d++) n += gZero[row * E + col + d];
		gRows[i] = n;
	}
	barrier();
	const int lx = int(gl_LocalInvocationID.x), ly = int(gl_LocalInvocationID.y);
	const int c = c0 + R + lx, r = r0 + R + ly;
	if (c >= W || r >= H) return;
	uint n = 0u;
	for (int d = 0; d <= 2 * R; d++) n += gRows[(ly + d) * T + lx];
	const uint m = int(n) > pc.mask_index ? 1u : 0u;
	const uint v = gImg[(ly + R) * F + lx + R];
	if (pc.pad > 0) { // scale 0 decimated: every second sample
		if ((c & 1) != 0 || (r & 1) != 0) return;
		const int j = c >> 1, i = r >> 1;
		if (j >= pc.pad || i >= pc.nd) return;
		oimg[i * pc.pad + j] = v;
		omask[i * pc.pad + j] = m;
	} else {
		oimg[r * W + c] = v;
		omask[r * W + c] = m;
	}
}
