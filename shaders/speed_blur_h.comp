#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 64) in;
#include "speed_common.glsl"
// The horizontal pass of the blur, then the plane minus its blur (subtract_image).
int mirror(int i, int n) { return i < 0 ? -i : (i >= n ? 2 * n - i - 2 : i); }
void main() {
	const int n = pc.DW * pc.DH, k = int(gl_GlobalInvocationID.x), p = int(gl_WorkGroupID.y);
	if (k >= n) return;
	const int i = k / pc.DW, j = k % pc.DW, base = p * n;
	precise float acc = 0.0;
	for (int fj = 0; fj < pc.fw; fj++) acc += filt[fj] * tmpv[base + i * pc.DW + mirror(j - pc.fw / 2 + fj, pc.DW)];
	precise float d = dec[base + k] - acc;
	prep[base + k] = d;
}
