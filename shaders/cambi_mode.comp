#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 16, local_size_y = 16) in;
#include "cambi_common.glsl"
// The 3x3 mode filter: the mode (else the minimum) of three, along the rows (pc.anti_dither 0: img -> tmp), then along the columns
// (pc.anti_dither 1: tmp -> img). The first and last rows keep their samples, the first and last columns their row-filtered ones.
layout(std430, binding = 0) buffer Img { uint img[]; };
layout(std430, binding = 1) buffer Tmp { uint tmp[]; };

uint cmin3(uint a, uint b, uint c) { return (a <= b && a <= c) ? a : (b <= c ? b : c); }
uint cmode3(uint a, uint b, uint c) { return (a == b || a == c) ? a : (b == c ? b : cmin3(a, b, c)); }

void main() {
	const int j = int(gl_GlobalInvocationID.x), i = int(gl_GlobalInvocationID.y);
	const int w = pc.W, h = pc.H;
	if (j >= w || i >= h) return;
	const int o = i * w + j;
	if (pc.anti_dither == 0) {
		tmp[o] = (j == 0 || j == w - 1) ? img[o] : cmode3(img[o - 1], img[o], img[o + 1]);
	} else if (i > 0 && i < h - 1) {
		img[o] = cmode3(tmp[o - w], tmp[o], tmp[o + w]);
	}
}
