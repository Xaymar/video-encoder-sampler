// AMF AV1: the options that change the picture at a fixed bitrate, with the values AMF accepts, and rules that leave out the combinations AMF
// refuses or ignores (the same stream twice). Run it as is (ves --config configs/amf-av1.jsonc) or copy the entry into your own config.
//
// Sources, cited as [H], [E] and [PA] below (AMF 1.4.3x, https://github.com/GPUOpen-LibrariesAndSDKs/AMF):
//   [H]  amf/public/include/components/VideoEncoderAV1.h and PreAnalysis.h, the property comments
//   [E]  amf/doc/AMF_Video_Encode_AV1_API.md, the property reference ("available only when ...", "requires ...")
//   [PA] amf/doc/AMF_Video_PreAnalysis_API.md
// Option names are AMF's property names in snake_case without the codec prefix (HevcEnableVBAQ is enable_vbaq; the pre-analysis ones keep "pa_"); ves
// lists them with `ves --list-options amf/av1`. ves opens the encoder with usage transcoding and CBR, peak bitrate = target bitrate.
// Rate control: CBR is the base; rate_control "vbr" is peak constrained VBR, capped at the target as ves sets the peak to it. Pre-analysis and
// pre-encode work with every rate control [E] (the header's "only works in peak constrained VBR" [H] is older than the API reference) and can help a
// lot, so they and their options are all here. The high quality modes (hqvbr, hqcbr) need pre-analysis [E]. RDNA 2 still has them, but they
// looked much worse than CBR with the high_quality preset [T], so they are commented out.
// Every list is cut to a spread of its range: ves numbers the combinations with one 64-bit number, so all value lists multiplied (rules aside) must stay
// below 9.2e18. Pruning tries the middle values only where the ends differ, so the ends of each range matter most.
// Features this GPU's encoder lacks (B-frames, reference frame counts) are left to the capability check: those runs are ignored, not failed.
{
	"output": "output",
	"scenarios": [
		{ "name": "sample", "bitrates": [6000], "resolutions": ["1920x1080"], "framerates": [60] },
	],
	"kfintervals": [2.0],
	"vmaf": { "model": ["path=models/vmaf_v1.0.16_1d5h_2160.json", "path=models/vmaf_v1.0.16_3d0h.json", "path=models/vmaf_v1.0.16_5d0h.json", "path=models/vmaf_v1.0.16_3d0h_2160.json"], "over_penalty": 0.025 },
	"settings": { "cache": "cache", "prune": true },

	"encoders": [
		{
			"enabled": true,
			"encoder": "amf",
			"codec": "av1",
			"options": {
				"preset": ["balanced", "quality", "high_quality"],   // speed made the same stream as balanced in every test on the 780M [T]; add "speed" back to retest
				"rate_control": [""],   // "": CBR; peak constrained "vbr" made the same stream as CBR with the peak at the target [T]; also lcvbr, qvbr, hqvbr, hqcbr
				// "rate_control": ["", "vbr", "hqvbr", "hqcbr"],   // to test whether this GPU still has the high quality modes
				"pre_encode": ["", 0, 1],   // Av1RateControlPreEncode; default depends on the usage [H]
				"b_pictures_pattern": ["", 1, 3, 7],   // B-frames, 0..127, default 0 [E]; RDNA 4 and later (AV1BFrames)
				"adaptive_mini_gop": ["", 1],   // adaptive B-frames; needs pre-analysis with a lookahead of 1 or more [E]
				// "max_consecutive_b_pictures": [...],   // 0..127; defaults to the B-frame count, or 3 with adaptive mini-GOP [E]
				"max_ref_frames": ["", 2, 4, 8],   // Av1MaxNumRefFrames, 0..8, default 1 [E]; 1 made the same stream as unset [T]
				"aq_mode": ["", 0, 1],   // 0 none, 1 content adaptive
				"high_motion_quality_boost": ["", 0, 1],
				"cdef_mode": ["", 0, 1],   // 0 off, 1 on
				"cdf_update": ["", 0, 1],
				"cdf_frame_end_update_mode": ["", 0, 1],
				"screen_content_tools": ["", 0, 1],   // on by default; allows the two below [H]
				"palette_mode": ["", 0, 1],
				"force_integer_mv": ["", 1],
				"num_tiles_per_frame": ["", 2, 4],   // 1 or more, default 1; a suggestion the encoder may change [H]
				"rate_control_skip_frame_enable": [""],   // lets the rate control drop frames; on or off made the same stream at CBR and VBR [T, AV1 too]. Was ["", 0, 1]
				"enforce_hrd": [""],   // on or off made the same stream at CBR and VBR [T, AV1 too]. Was ["", 0, 1]
				// "filler_data": [0, 1],   // pads the stream to the bitrate: the picture stays the same
				// "vbv_buffer_size": [...],   // bits, so the same value means a different buffer at every bitrate
				// "min_q_index_intra": [...], "max_q_index_intra": [...], ...   // Q index limits only take quality away from the rate control

				// Pre-analysis [PA]: its pa_* properties only exist once enable_pre_analysis is on (ves sets that first).
				"enable_pre_analysis": ["", 1],   // off in the transcoding usage [E]
				"pa_look_ahead_buffer_depth": ["", 0, 1, 11, 21, 41],   // AMD suggests 1, 11, 21 or 41 [PA]; unset is 0 on AMF 1.4.37 and not 0 on 1.5.3 [T], so it is set explicitly with pre-analysis on
				"pa_perceptual_aq_mode": ["", 1],   // 1 CAQ; replaces VBAQ [PA]
				"pacaq_strength": ["", 0, 2],   // CAQ strength: 0 low, 1 medium (default), 2 high
				"pa_temporal_aq_mode": ["", 1, 2],   // 1 for video, 2 for games (DX11 only, which ves uses); replaces VBAQ, needs lookahead [PA]
				"pa_high_motion_quality_boost_mode": ["", 1],   // 1 auto; needs lookahead [PA]
				"pa_scene_change_detection_enable": ["", 0],   // on by default
				"pa_scene_change_detection_sensitivity": ["", 0, 2],   // 0 low, 1 medium (default), 2 high; only with lookahead 0 [PA]
				// Static scene detection codes static frames as skip frames and needs a lookahead [PA]. On the 9800X3D iGPU (RDNA 2, AMF 1.4.37) with the check clip's
				// still segment it worked (on the 780M too, RDNA 3, AMF 1.5.3), but only with sensitivity 0 or 1: unset (2, high) made the same stream as off, and the max QP before force skip changed
				// nothing [T on H.264 and HEVC]. On AV1 (780M) it changed nothing at all, at any sensitivity, and did not crash [T].
				// It also bluescreens the 780M (RDNA 3, AMF 1.5.3, 0x119 in amdkmdag.sys) whenever two or more encodes run at once ("parallel" 2 or more), and with
				// the max QP below set even with one at a time [T]. Sweeps run in parallel, so it is left out.
				// Only on RDNA 2 or later GPUs known to handle it, use:
				// "pa_static_scene_detection_enable": ["", 1],
				// "pa_static_scene_detection_sensitivity": ["", 0, 1],   // 0 low, 1 medium, 2 high (default)
				// "pa_max_qp_before_force_skip": ["", 20, 51],   // 0..51, default 35: static frames are skipped only below this QP [PA]; changed nothing on RDNA 2 [T]
				"pa_activity_type": ["", 1],   // 0 luma (default), 1 luma and chroma; no effect without perceptual AQ [T]
				"pa_frame_sad_enable": ["", 0],   // on by default; no effect without perceptual AQ [T]
				"pa_long_term_reference_enable": ["", 1],   // automatic long-term references
				// "pa_initial_qp_after_scene_change": [...],   // 0..51: a fixed QP after cuts only takes the choice from the rate control

				// The pre-encode filter in front of the encoder (ves's own; see config.all-options.jsonc).
				"pre_filter": ["", 1],
				"pre_filter_strength": [""],   // 0..10; 0, 4 and 10 made the same stream as unset on both GPUs and codecs [T], so AMF seems to ignore it. Was ["", 0, 4, 10]
				"pre_filter_sensitivity": [""],   // 0..10, lower keeps more detail; ignored like the strength [T]. Was ["", 0, 4, 10]
			},
			"rules": [
				// AMF's AV1 profile is main: 4:2:0 only.
				{ "op": "!=", "left": { "option": "chroma" }, "right": 444 },
				// Palette mode and integer motion vectors are "valid only when AMF_VIDEO_ENCODER_AV1_SCREEN_CONTENT_TOOLS is true" [H].
				{
					"if": { "op": "==", "left": { "option": "screen_content_tools" }, "right": 0 },
					"require": [
						{ "op": "not", "value": { "set": "palette_mode" } },
						{ "op": "not", "value": { "set": "force_integer_mv" } },
					],
				},
				// Adaptive mini-GOP takes priority over the B-frame count [E]: it runs with one count, 3, the one AMD recommends with it [E].
				{
					"if": { "set": "adaptive_mini_gop" },
					"require": { "op": "==", "left": { "option": "b_pictures_pattern" }, "right": 3 },
				},
				// High quality VBR and CBR "require Pre-Analysis to be enabled" and are 8-bit only [E]; QVBR aims at a quality level instead of the bitrate and is left out.
				{
					"if": { "op": "in", "left": { "option": "rate_control" }, "right": ["hqvbr", "hqcbr"] },
					"require": [
						{ "op": "==", "left": { "option": "enable_pre_analysis" }, "right": 1 },
						{ "op": "!=", "left": { "option": "bitdepth" }, "right": 10 },   // "only for 8-bit color bit depth" [E]
					],
				},
				// Pre-analysis options need pre-analysis [PA].
				{
					"if": { "op": "or", "args": [{ "op": "not", "value": { "set": "enable_pre_analysis" } }, { "op": "==", "left": { "option": "enable_pre_analysis" }, "right": 0 }] },
					"require": [
						{ "op": "not", "value": { "set": "pa_look_ahead_buffer_depth" } },
						{ "op": "not", "value": { "set": "pa_perceptual_aq_mode" } },
						{ "op": "not", "value": { "set": "pacaq_strength" } },
						{ "op": "not", "value": { "set": "pa_temporal_aq_mode" } },
						{ "op": "not", "value": { "set": "pa_high_motion_quality_boost_mode" } },
						{ "op": "not", "value": { "set": "pa_scene_change_detection_enable" } },
						{ "op": "not", "value": { "set": "pa_scene_change_detection_sensitivity" } },
						{ "op": "not", "value": { "set": "pa_static_scene_detection_enable" } },
						{ "op": "not", "value": { "set": "pa_static_scene_detection_sensitivity" } },
						{ "op": "not", "value": { "set": "pa_max_qp_before_force_skip" } },
						{ "op": "not", "value": { "set": "pa_activity_type" } },
						{ "op": "not", "value": { "set": "pa_frame_sad_enable" } },
						{ "op": "not", "value": { "set": "pa_long_term_reference_enable" } },
						{ "op": "not", "value": { "set": "adaptive_mini_gop" } },
					],
				},
				// TAQ, PA high motion boost, static scene detection and adaptive mini-GOP need a lookahead of at least 1 [PA][E]; the scene change sensitivity only applies without one [PA].
				{
					"if": { "op": "and", "args": [{ "set": "pa_look_ahead_buffer_depth" }, { "op": "==", "left": { "option": "pa_look_ahead_buffer_depth" }, "right": 0 }] },
					"require": [
						{ "op": "not", "value": { "set": "pa_temporal_aq_mode" } },
						{ "op": "not", "value": { "set": "pa_high_motion_quality_boost_mode" } },
						{ "op": "not", "value": { "set": "pa_static_scene_detection_enable" } },
						{ "op": "not", "value": { "set": "adaptive_mini_gop" } },
					],
					"else_require": { "op": "not", "value": { "set": "pa_scene_change_detection_sensitivity" } },
				},
				{
					"if": { "op": "==", "left": { "option": "pa_scene_change_detection_enable" }, "right": 0 },
					"require": { "op": "not", "value": { "set": "pa_scene_change_detection_sensitivity" } },
				},
				{
					"if": { "op": "not", "value": { "set": "pa_static_scene_detection_enable" } },
					"require": [
						{ "op": "not", "value": { "set": "pa_static_scene_detection_sensitivity" } },
						{ "op": "not", "value": { "set": "pa_max_qp_before_force_skip" } },
					],
				},
				// [T] below: configs/check/amf-{h264,hevc}-pa-scene, 2026-11-18, on Areldir (9800X3D iGPU, AMF 1.4.37) and Irkela (780M, AMF 1.5.3): 352 runs, 10 to 12 different streams. Assumed for AV1 (not tested yet).
				// An unset lookahead is the runtime's default: 0 on AMF 1.4.37 (and with scene change detection that overshot CBR by 58%, see below), another depth on
				// 1.5.3 [T]. So with pre-analysis on the depth is always set, 11 being the documented default [PA].
				{
					"if": { "op": "==", "left": { "option": "enable_pre_analysis" }, "right": 1 },
					"require": { "set": "pa_look_ahead_buffer_depth" },
				},
				// The activity type and frame SAD changed nothing without perceptual AQ, with or without temporal AQ [T].
				{
					"if": { "op": "not", "value": { "set": "pa_perceptual_aq_mode" } },
					"require": [
						{ "op": "not", "value": { "set": "pa_activity_type" } },
						{ "op": "not", "value": { "set": "pa_frame_sad_enable" } },
					],
				},
				// With scene change detection off, the lookahead depth ("", 0, 21) changed nothing (so 0 stands for all) unless something else reads the lookahead [T].
				{
					"if": { "op": "and", "args": [
						{ "op": "==", "left": { "option": "pa_scene_change_detection_enable" }, "right": 0 },
						{ "op": "not", "value": { "set": "pa_temporal_aq_mode" } },
						{ "op": "not", "value": { "set": "pa_high_motion_quality_boost_mode" } },
						{ "op": "not", "value": { "set": "pa_static_scene_detection_enable" } },
						{ "op": "not", "value": { "set": "pa_perceptual_aq_mode" } },
					] },
					"require": { "op": "==", "left": { "option": "pa_look_ahead_buffer_depth" }, "right": 0 },
				},
				// Lookahead 0 with scene change detection on (and no long-term references) broke CBR: 7.4 to 11.4 Mbps for 6 Mbps [T], so those are left out.
				{
					"if": { "op": "and", "args": [
						{ "set": "pa_look_ahead_buffer_depth" },
						{ "op": "==", "left": { "option": "pa_look_ahead_buffer_depth" }, "right": 0 },
						{ "op": "not", "value": { "set": "pa_long_term_reference_enable" } },
					] },
					"require": { "op": "==", "left": { "option": "pa_scene_change_detection_enable" }, "right": 0 },
				},
				// The CAQ strength is the perceptual AQ's; with perceptual or temporal AQ the encoder's own AQ mode is ignored [PA].
				{
					"if": { "op": "not", "value": { "set": "pa_perceptual_aq_mode" } },
					"require": { "op": "not", "value": { "set": "pacaq_strength" } },
				},
				{
					"if": { "op": "or", "args": [{ "set": "pa_perceptual_aq_mode" }, { "set": "pa_temporal_aq_mode" }] },
					"require": { "op": "not", "value": { "set": "aq_mode" } },
				},
				// [T] below: configs/check/amf-{h264,hevc}-pa-aq and -picture, 2026-11-18, Irkela (780M, AMF 1.5.3), the same on both codecs. Assumed for AV1.
				// With pre-analysis on, VBAQ changed nothing even without perceptual or temporal AQ [T]; without it, the high motion boost changed nothing [T].
				{
					"if": { "op": "==", "left": { "option": "enable_pre_analysis" }, "right": 1 },
					"require": { "op": "not", "value": { "set": "aq_mode" } },
					"else_require": { "op": "not", "value": { "set": "high_motion_quality_boost" } },
				},
				// Temporal AQ wins over perceptual AQ: with it, perceptual AQ and the CAQ strength changed nothing [T].
				{
					"if": { "set": "pa_temporal_aq_mode" },
					"require": [
						{ "op": "not", "value": { "set": "pa_perceptual_aq_mode" } },
						{ "op": "not", "value": { "set": "pacaq_strength" } },
					],
				},
				// With a lookahead of 1, temporal AQ 1 and 2 made the same stream [T].
				{
					"if": { "op": "==", "left": { "option": "pa_look_ahead_buffer_depth" }, "right": 1 },
					"require": { "op": "!=", "left": { "option": "pa_temporal_aq_mode" }, "right": 2 },
				},
				// Static scene detection only did something with sensitivity 0 or 1 [T].
				{
					"if": { "set": "pa_static_scene_detection_enable" },
					"require": { "set": "pa_static_scene_detection_sensitivity" },
				},
				// With CDF updates off, the frame end update mode changed nothing [T on the 780M].
				{
					"if": { "op": "==", "left": { "option": "cdf_update" }, "right": 0 },
					"require": { "op": "not", "value": { "set": "cdf_frame_end_update_mode" } },
				},
				// The pre-filter settings need the pre-filter.
				{
					"if": { "op": "not", "value": { "set": "pre_filter" } },
					"require": [
						{ "op": "not", "value": { "set": "pre_filter_strength" } },
						{ "op": "not", "value": { "set": "pre_filter_sensitivity" } },
					],
				},
			],
		},
	],
}
