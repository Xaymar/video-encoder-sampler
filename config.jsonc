// Example configuration for ves. Comments (// and /* */) and trailing commas are allowed.
//
// Run it with:   ves --config config.jsonc -i <video or folder>   (or just `ves` in this folder: config.jsonc is the default)
// Everything here can also be given on the command line, see `ves --help`.
//
// How a sweep is made up: for every input, scenario (bitrates x resolutions x frame rates x key frame intervals) and encoder,
// every combination of the encoder's option lists is encoded, scored with VMAF on every frame, and ranked: the configurations that
// are the best in at least 95% of the frames are the winners.
{
	// ---- What to test -------------------------------------------------------------------------------------------------------------
	// Input videos: files, folders of .mkv, .mp4 and .mov, or http(s) URLs (downloaded once into the cache folder). `--input` on the command line
	// replaces this list.
	// (Left out here so that a missing folder does not stop the run.)
	// "inputs": ["videos", "D:/clips/one.mp4"],

	// Where the results go: the encoded stream of every run (a fragmented .mp4) and one result .json per input. "" / false writes nothing.
	"output": "output",

	// A scenario is one sub-sweep. Encoders can be limited to some of them with "scenarios" (see below), so that combinations that make
	// no sense together are not run, e.g. 4k at 3.5 Mbit.
	"scenarios": [
		{
			"name": "high",
			// Target bitrates in kbit/s. Running over the target is penalised (see "vmaf" below), running under is not.
			"bitrates": [16000, 12000],
			// Encoded resolutions. They are scaled back to the source resolution for scoring.
			"resolutions": ["3840x2160", "2560x1440"],
			// Encoded frame rates: 30, 29.97, or a fraction such as 30000/1001. Frames are dropped to get there, never invented.
			"framerates": [120, 60, 30],
			// "kfintervals": [2.0, 1.0],   // key frame intervals in seconds; defaults to the top-level list below
			// "chroma": [420, 444],        // the pixel format and sample range the encoders get; left out, the source's. Every combination is tested
			// "bitdepth": [8, 10],
			// "range": ["limited", "full"],   // source, limited or full: the samples are converted before encoding and back for scoring
			// "upscale": true,             // allow encoding above the source's resolution, chroma layout and bit depth (off by default)
		},
		{
			"name": "mid",
			"bitrates": [8500, 6000],
			"resolutions": ["2560x1440", "1920x1080", "1280x720"],
			"framerates": [120, 60, 30],
		},
		{
			"name": "low",
			"bitrates": [6000, 3500],
			"resolutions": ["1920x1080", "1280x720"],
			"framerates": [60, 30],
		},
	],

	// Key frame interval(s) in seconds, for scenarios that do not list their own.
	"kfintervals": [2.0],

	// ---- Scaling ------------------------------------------------------------------------------------------------------------------
	"scaling": {
		// libplacebo scalers, used for any change of resolution (and for scaling the decoded video back for scoring).
		"upscaler": "ewa_lanczos",
		"downscaler": "ewa_lanczos",
		// "gpu": "NVIDIA GeForce RTX 4080 SUPER",   // Vulkan GPU for scaling, by its exact name; left out, libplacebo picks one
	},

	// ---- Scoring ------------------------------------------------------------------------------------------------------------------
	"vmaf": {
		// Running over the target bitrate costs this many VMAF points per percent for a run just over; the cost grows exponentially, as on the website
		// (2% over loses 0.07, 10% 1.9, 20% 59). The default is about what 3000 -> 6000 kbit/s gains.
		"over_penalty": 0.025,
		// Model file, relative to the working directory ("path=..."), or a built-in one ("version=..."), which the libvmaf we ship has none of.
		// The "neg" models (no enhancement gain) do not reward sharpening or contrast changes; vmaf_4k_v0.6.1neg is meant for 4K viewing,
		// vmaf_v0.6.1neg for 1080p. models/ also has the plain ones (vmaf_4k_v0.6.1.json, vmaf_v0.6.1.json).
		"model": "path=models/vmaf_4k_v0.6.1neg.json",
		// Threads per run being scored; 0 shares all cores between the runs that are scored at the same time.
		"threads": 0,
		// Where VMAF is computed: "cpu" (libvmaf), "gpu" (Vulkan compute: about ten times faster, 8 and 10 bit input, scores within 1e-4 of libvmaf's;
		// a run it cannot score fails) or "auto" (the GPU where it can be used, else the CPU). Scores from the GPU are cached apart from the CPU's.
		"device": "cpu",
		// Which Vulkan device scores on the GPU: "auto" (the GPU that encodes the run, so frames do not cross between GPUs; for CPU encoders, or where that
		// GPU cannot score, the first discrete GPU), a number (Vulkan's device order, which can differ from the encoders' "gpu" numbers), or part of
		// the device's name, e.g. "RX 7600". `ves --vmaf-gpu list` shows the devices.
		"gpu": "auto",
	},

	// ---- Uploading results to a VES website, as the runs are scored ----------------------------------------------------------------------
	// "upload": {
	//   "url": "https://ves.example.com",
	//   "key": "ves_...",    // from the website's account page; or leave it out and set the VES_API_KEY environment variable
	//   "videos": true,      // false: upload the results but not the encoded videos
	// },

	// ---- Settings: caching, saved streams, decoding and memory ------------------------------------------------------------
	"settings": {
		// The cache folder: downloaded inputs go here (and so do the results of finished runs, but only when there is no "output" folder; with
		// one, each run's result file is kept next to its stream there, and a run whose result file exists is not repeated). "" / false (or
		// `--cache off`) turns it off.
		"cache": "cache",
		// true / "best": keep only the stream of the winner (best in the most frames, after the overshoot penalty) of each input, encoder, bitrate, key frame interval and size (uploaded once the
		// group is complete; a stream an earlier sweep sent that is beaten now is removed from the site). "all": keep every stream. false: result files only.
		"videos": "best",
		// Decode the sources on the GPU when that gives exactly the same frames as software (checked on the first 120 frames):
		// "auto", false for software only, a device ("cuda", "d3d11va", "d3d12va", "dxva2", "qsv", "amf", "vaapi", "vulkan") or a decoder
		// ("hevc_cuvid"). The encoded streams that are scored are always decoded in software.
		"hw_decode": "auto",
		"decode_threads": 0,   // threads per decoder; 0 uses every core
		"priority": "low",     // "low": idle CPU priority and the lowest disk priority, so ves never slows down other programs; "normal": the system default
		"low_memory": false,   // true: fewer VMAF and decoder threads, much less memory, a bit slower
		// An option that shows no effect is not swept further: within a group, for every combination of the other options, the lowest and the highest
		// value of a list run first, and when they score the same on every frame the values in between are skipped. Set to false to run
		// every combination. Per encoder, "fixed" lists options that are never pruned.
		"prune": true,
	},

	// ---- Encoders -----------------------------------------------------------------------------------------------------------------
	// Every option is a list of values and every combination is tested. Special values:
	//   (null is not a value: it would mean "whatever the preset gives", which ves cannot know. To run without an option, leave it out.)
	//   ""    leaves the option at the encoder's default (it is not passed on), so ["", "film"] tests no tune and film; for x264 and x265 that is how to run without a tune
	//   []    ignores the option (as if it were not there), handy for switching one off without deleting it
	// Option names are snake_case. Some are common: the same name and meaning for every encoder that can do them (an encoder that cannot fails the
	// run with a message): max_b_frames, lookahead_frames, max_ref_frames, b_reference_mode (none | middle | each) and rate_control (cbr | vbr).
	// The rest are the encoder's own, written snake_case: x264, x265 and SVT-AV1 command line names (aq-mode is aq_mode), NVENC's structure fields
	// (enable_ltr), AMF's property names without the codec prefix (QualityPreset is preset), QuickSync's field names (TargetUsage is preset, CodecProfile is profile).
	// An unknown name fails the run. config.all-options.jsonc lists them all.
	"encoders": [
		{
			"enabled": true,
			"encoder": "nvenc",             // nvenc | amf | qsv | x264 | x265 | svtav1
			"codec": "h264",                // h264 | hevc | av1, for the GPU encoders
			"options": {
				"preset": ["p1", "p2", "p3", "p4", "p5", "p6", "p7"],
				"tune": ["hq"],             // hq | ll | ull | lossless
				// "rate_control": ["cbr", "vbr"],
				// "max_b_frames": [0, 1, 2, 3, 4],
				// "lookahead_frames": [32, 16, 8, 0],
				// "b_reference_mode": ["none", "middle"],  // B-frames as references
				// An option that does nothing without another one, or when another one is set, takes its values in an object. It is left unset where
				// the condition fails ("set" means it is listed and its own condition holds), and combinations that come out the same run once:
				// "requires" and "unless" take an option name, a list of names, or an object of name to what it must be: true (set), a value, a list of
				// values, or a comparison with a number ("<", "<=", ">", ">=", "==", "!="):
				// "hierarchical_b_frames": { "values": [0, 1], "requires": { "max_b_frames": ">=2" } },   // a single B-frame cannot be in a hierarchy
				// "b_reference_mode": { "values": ["none", "middle"], "requires": { "max_b_frames": ">=2" } },
				// "weighted_prediction": { "values": [0, 1], "unless": { "max_b_frames": ">=1" } },
				// "b_adapt": { "values": [0, 1], "requires": "max_b_frames" },                          // only with max_b_frames set
				// "spatial_aq": [0, 1, 8, 15],             // 0 is off, 1..15 is on with that strength
				// "gpu": [0],                                    // which NVIDIA GPU; ["all"] uses every one, each in a pool of its own
			},
			// "scenarios": ["mid", "low"],  // only these scenarios; left out, the encoder takes part in all of them
			// "pool": "nvenc",              // runs in one pool share a device; at most "parallel" of them run at the same time
			// "parallel": 2,                // runs of this pool in one wave (default 2 for GPU encoders, 1 for the CPU ones)
			// "fixed": ["preset"],          // options of this encoder that are never pruned
			// "prune": false,               // this encoder only: run every combination
		},
		{
			"enabled": false,
			"encoder": "x264",
			"scenarios": ["mid", "low"],
			"options": {
				"preset": ["veryfast", "fast", "medium", "slow", "veryslow"],
				"tune": ["film", "animation"],
				// "max_b_frames": [0, 3],
				// "lookahead_frames": [20, 40],
				// "max_ref_frames": [3, 5],
			},
		},
		{
			"enabled": false,
			"encoder": "x265",
			"scenarios": ["mid", "low"],
			"options": {
				"preset": ["superfast", "veryfast", "fast", "medium"],
				"tune": [],
				// "max_b_frames": [2, 4],
			},
		},
		{
			"enabled": false,
			"encoder": "svtav1",
			"options": {
				// Runs as CBR with the low-delay prediction structure; "rate_control": ["vbr"] gives VBR with the random-access structure instead.
				// SVT-AV1 is not deterministic, so its results vary a little between runs.
				"preset": [6, 8, 10],
				// "lookahead_frames": [0, 16],
				// "enable_tf": [0, 1],
			},
		},
		{
			"enabled": false,
			"encoder": "amf",                // AMD GPUs; the property names are AMF's, values numeric
			"codec": "h264",
			"options": {
				"preset": ["speed", "balanced", "quality"],   // speed | balanced | quality | high_quality
				// "max_b_frames": [0, 1, 2],
			},
		},
		{
			"enabled": false,
			"encoder": "qsv",                // Intel GPUs; field names of oneVPL's mfxInfoMFX and extension buffers
			"codec": "hevc",
			"options": {
				"preset": ["best_quality", "balanced", "best_speed"],   // QuickSync's target usage; 1 ... 7 also work
				// "max_b_frames": [0, 3],
				// "lookahead_frames": [0, 40],
				// "b_reference_mode": ["none", "middle"],
			},
		},
	],
}
