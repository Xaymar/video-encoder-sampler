// Example configuration for ves. Comments (// and /* */) and trailing commas are allowed.
//
// Run it with:   ves --config config.jsonc -i <video or folder>   (or just `ves` in this folder: config.jsonc is the default)
// Everything here can also be given on the command line, see `ves --help`.
//
// How a sweep is made up: for every input, scenario (bitrates x resolutions x frame rates x key frame intervals) and encoder,
// every combination of the encoder's option lists is encoded, scored with VMAF on every frame, and ranked: the configurations that
// are the best in at least 95% of the frames are the winners.
{
	// ---- What to test -------------------------------------------------------------------------------------------------------------
	// Input videos: files or folders of .mkv, .mp4 and .mov. `--input` on the command line replaces this list.
	// (Left out here so that a missing folder does not stop the run.)
	// "inputs": ["videos", "D:/clips/one.mp4"],

	// A scenario is one sub-sweep. Encoders can be limited to some of them with "scenarios" (see below), so that combinations that make
	// no sense together are not run, e.g. 4k at 3.5 Mbit.
	"scenarios": [
		{
			"name": "high",
			// Target bitrates in kbit/s. Running over the target is penalised (see "vmaf" below), running under is not.
			"bitrates": [16000, 12000],
			// Encoded resolutions. They are scaled back to the source resolution for scoring.
			"resolutions": ["3840x2160", "2560x1440"],
			// Encoded frame rates: 30, 29.97, or a fraction such as 30000/1001. Frames are dropped to get there, never invented.
			"framerates": [120, 60, 30],
			// "kfintervals": [2.0, 1.0],   // key frame intervals in seconds; defaults to the top-level list below
			// "upscale": true,             // allow encoding above the source's resolution, chroma layout and bit depth (off by default)
		},
		{
			"name": "mid",
			"bitrates": [8500, 6000],
			"resolutions": ["2560x1440", "1920x1080", "1280x720"],
			"framerates": [120, 60, 30],
		},
		{
			"name": "low",
			"bitrates": [6000, 3500],
			"resolutions": ["1920x1080", "1280x720"],
			"framerates": [60, 30],
		},
	],

	// Key frame interval(s) in seconds, for scenarios that do not list their own.
	"kfintervals": [2.0],

	// ---- Scaling ------------------------------------------------------------------------------------------------------------------
	"scaling": {
		// libplacebo scalers, used for any change of resolution (and for scaling the decoded video back for scoring).
		"upscaler": "ewa_lanczos",
		"downscaler": "ewa_lanczos",
		// "gpu": "NVIDIA GeForce RTX 4080 SUPER",   // Vulkan GPU for scaling, by its exact name; left out, libplacebo picks one
	},

	// ---- Scoring ------------------------------------------------------------------------------------------------------------------
	"vmaf": {
		// Running over the target bitrate costs this many VMAF points per percent. The default is about what 3000 -> 6000 kbit/s gains.
		"over_penalty": 0.025,
		// Model file, relative to the working directory ("path=..."), or a built-in one ("version=vmaf_v0.6.1").
		"model": "path=models/vmaf_4k_v0.6.1.json",
		// Threads per run being scored; 0 shares all cores between the runs that are scored at the same time.
		"threads": 0,
	},

	// ---- Where things go ----------------------------------------------------------------------------------------------------------
	// Finished runs are kept here and not repeated when the same input, encoder, options, bitrate and tool versions come up again.
	// Delete the folder to start over, or use "" / false (or `--cache off`) to turn it off.
	"cache": "cache",
	// The encoded stream of every run (a fragmented .mp4) and one result .json per input go here. "" / false writes nothing.
	"output": "output",
	"videos": true,        // false: write the result files but not the encoded streams

	// ---- Settings: decoding, memory and pruning -----------------------------------------------------------------------------------
	"settings": {
		// Decode the sources on the GPU when that gives exactly the same frames as software (checked on the first 120 frames):
		// "auto", false for software only, a device ("cuda", "d3d11va", "d3d12va", "dxva2", "qsv", "amf", "vaapi", "vulkan") or a decoder
		// ("hevc_cuvid"). The encoded streams that are scored are always decoded in software.
		"hw_decode": "auto",
		"decode_threads": 0,   // threads per decoder; 0 uses every core
		"low_memory": false,   // true: fewer VMAF and decoder threads, much less memory, a bit slower
		// Options that change nothing (alone or together with the others) are found by comparing output bytes and left out of the sweep.
		// Set to false to test every combination regardless. Per encoder, "fixed" lists options that are never pruned (presets and tunes
		// set the defaults of everything else, so each of their combinations is screened separately).
		"prune": true,
	},

	// ---- Encoders -----------------------------------------------------------------------------------------------------------------
	// Every option is a list of values and every combination is tested. Special values:
	//   null  leaves the option unset (the encoder's default), so [null, 1, 2] tests the default as well
	//   []    ignores the option (as if it were not there), handy for switching one off without deleting it
	// Option names are the encoder's own (x264, x265 and SVT-AV1 command line names; NVENC as below; AMF property names; QuickSync
	// field names), and an unknown name fails the run. "chroma" (420, 444) and "bitdepth" (8, 10) work for every encoder.
	"encoders": [
		{
			"enabled": true,
			"encoder": "nvenc",             // nvenc | amf | qsv | x264 | x265 | svtav1
			"codec": "h264",                // h264 | hevc | av1, for the GPU encoders
			"fixed": ["preset", "tune"],
			"options": {
				"preset": ["p1", "p2", "p3", "p4", "p5", "p6", "p7"],
				"tune": ["hq"],             // hq | ll | ull | lossless
				// "rc": ["cbr", "vbr"],
				// "bf": [null, 0, 1, 2, 3, 4],                   // B-frames
				// "rc-lookahead": [32, 16, 8, 0],
				// "b_ref_mode": [null, "none", "middle"],       // B-frames as references (h264 and hevc)
				// "spatial-aq": [null, 0, 1],
				// "aq-strength": [],
				// "bitdepth": [8, 10],
				// "gpu": [0],                                    // which NVIDIA GPU; ["all"] uses every one, each in a pool of its own
			},
			// "scenarios": ["mid", "low"],  // only these scenarios; left out, the encoder takes part in all of them
			// "pool": "nvenc",              // runs in one pool share a device; at most "parallel" of them run at the same time
			// "parallel": 2,                // runs of this pool in one wave (default 2 for GPU encoders, 1 for the CPU ones)
			// "prune": false,               // this encoder only: test every combination
		},
		{
			"enabled": false,
			"encoder": "x264",
			"scenarios": ["mid", "low"],
			"fixed": ["preset", "tune"],
			"options": {
				"preset": ["veryfast", "fast", "medium", "slow", "veryslow"],
				"tune": [null, "film", "animation"],
				// "bframes": [0, 3],
				// "rc-lookahead": [20, 40],
				// "ref": [3, 5],
			},
		},
		{
			"enabled": false,
			"encoder": "x265",
			"scenarios": ["mid", "low"],
			"fixed": ["preset", "tune"],
			"options": {
				"preset": ["superfast", "veryfast", "fast", "medium"],
				"tune": [null],
				// "bframes": [2, 4],
				// "bitdepth": [8, 10],
			},
		},
		{
			"enabled": false,
			"encoder": "svtav1",
			"fixed": ["preset"],
			"options": {
				// Runs as CBR with the low-delay prediction structure; "rc": [1], "pred-struct": [2] gives VBR instead.
				// SVT-AV1 is not deterministic, so its results vary a little between runs and it is never pruned.
				"preset": [6, 8, 10],
				// "lookahead": [0, 16],
				// "enable-tf": [0, 1],
			},
		},
		{
			"enabled": false,
			"encoder": "amf",                // AMD GPUs; the property names are AMF's, values numeric
			"codec": "h264",
			"fixed": ["QualityPreset"],
			"options": {
				"QualityPreset": [0, 1, 2],   // H.264: 0 balanced, 1 speed, 2 quality
				// "BPicturesPattern": [0, 1, 2],
			},
		},
		{
			"enabled": false,
			"encoder": "qsv",                // Intel GPUs; field names of oneVPL's mfxInfoMFX and extension buffers
			"codec": "hevc",
			"fixed": ["TargetUsage"],
			"options": {
				"TargetUsage": [1, 4, 7],     // 1 best quality ... 7 fastest, or best_quality | balanced | best_speed
				// "GopRefDist": [1, 4],
				// "LookAheadDepth": [0, 40],
				// "BRefType": [0, 2],
			},
		},
	],
}
